# Qomon Configuration
# Copy this file to .env and fill in your actual values.
# Variable names follow the tap's setting keys; run `tap-qomon --about` for the
# authoritative list.

# Required: Qomon API key from space settings
TAP_QOMON_API_KEY=your_api_key_here

# Optional: API base URL (defaults to https://incoming.qomon.app)
TAP_QOMON_API_BASE_URL=https://incoming.qomon.app

# Optional: Earliest contact UpdatedAt to sync on the first run (ISO-8601)
TAP_QOMON_START_DATE=2023-01-01T00:00:00Z
